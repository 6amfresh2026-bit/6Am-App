# Single source of truth for build-time keys and hosts.
#
# Copy to `config/keys.env` and fill in the real values. That file is
# gitignored — never commit a live key.
#
# One file, three consumers:
#   • Dart    — flutter run --dart-define-from-file=config/keys.env
#   • Android — android/app/build.gradle.kts reads it into a manifest placeholder
#   • iOS     — tool/generate_ios_keys.sh writes ios/Flutter/Keys.xcconfig from it
#
# Google Cloud APIs that must be enabled for this key:
#   Maps SDK for Android · Maps SDK for iOS · Places API · Geocoding API
# Billing must be active, or every call returns REQUEST_DENIED.

MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
API_BASE_URL=https://6amfresh.in/api/v1
